---
import config from "@/config/config.json";
import ImageMod from "./ImageMod.astro";

const {
  src,
  className,
  width,
  height,
  style,
}: {
  src?: string;
  className?: string;
  width?: number;
  height?: number;
  style?: any;
} = Astro.props;

const {
  logo,
  logo_width,
  logo_height,
  logo_text,
  title,
}: {
  logo: string;
  logo_width: any;
  logo_height: any;
  logo_text: string;
  title: string;
} = config.site;
---

<a href="/" class={`navbar-brand inline-block`}>
  {
    src || logo ? (
      <>
        <ImageMod
          src={src ? src : logo}
          class={`inline-block ${className ? className : ""}`}
          width={width ? width * 2 : logo_width.replace("px", "") * 2}
          height={height ? height * 2: logo_height.replace("px", "") * 2}
          alt={title}
          style={
            style
              ? style
              : {
                  height:
                    (height ? height : logo_height.replace("px", "")) + "px",
                  width: (width ? width : logo_width.replace("px", "")) + "px",
                }
          }
          format="webp"
        />
      </>
    ) : logo_text ? (
      logo_text
    ) : (
      title
    )
  }
</a>
